# Server port (default: 3001)
PORT=3001

# Resend API key – create at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email address that receives contact form submissions
CONTACT_TO_EMAIL=info@pearlparadisetours.com

# Sender address for outgoing emails (Resend verified domain or onboarding@resend.dev)
# FROM_EMAIL=onboarding@resend.dev

# Allowed origin for CORS (default: http://localhost:5173)
# CORS_ORIGIN=http://localhost:5173
